# Salin jadi .env lalu isi yang perlu. Tanpa kredensial penyedia, server tetap
# jalan: OTP dan email dicetak ke log, dan tombol Google/Facebook melaporkan
# dirinya belum dikonfigurasi alih-alih gagal diam-diam.

PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_FILE=dbtc.sqlite

# Wajib diganti di produksi — dipakai mem-hash token sesi dan OTP.
TOKEN_PEPPER=ganti-dengan-string-acak-panjang

# Google — console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:5173/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — developers.facebook.com → App → Facebook Login → Settings
# Valid OAuth Redirect URI: http://localhost:5173/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# SMS OTP (Twilio). Kosongkan untuk mencetak kode ke log server.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email (SMTP). Kosongkan untuk mencetak isi email ke log server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DBTC <no-reply@dbtc.id>

# Midtrans — dashboard.midtrans.com → Settings → Access Keys
# Tanpa ini, pembayaran memakai simulator yang menyebut dirinya simulator.
# Di produksi, tidak adanya kunci ini menghentikan start.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

# URL webhook yang didaftarkan di Midtrans:
#   https://<domain>/api/payments/webhook

# Web Push — buat sekali dengan: npx web-push generate-vapid-keys
# Jangan dibangkitkan ulang: kunci publiknya tersimpan di setiap langganan
# peramban, dan menggantinya membuat semuanya tidak bisa dipakai.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dbtc.id

# Postgres. Kalau diisi, DATABASE_FILE diabaikan.
DATABASE_URL=

# Kontak yang otomatis jadi admin klub, dipisah koma.
ADMIN_CONTACTS=
